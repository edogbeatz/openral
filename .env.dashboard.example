# Sibling Acquire for laptop `/simple` chat.
# Copy to ~/.openral/dashboard.env (mode 0600) or `.env.dashboard` (gitignored):
#   just dashboard-acquire-env
# or:
#   ACQUIRE_API_KEY='<Railway acquire-api API_KEY>' \
#     uv run openral dashboard --init-acquire-env
# `openral dashboard` loads the file when ACQUIRE_API_* are unset.
# Do not commit the key.

ACQUIRE_API_URL=https://acquire-api-production.up.railway.app
ACQUIRE_API_KEY=
